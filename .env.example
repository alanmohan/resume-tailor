# Resume Tailor backend configuration (template).
# Copy to ".env" in the project root and fill in the secrets:   test -f .env || cp .env.example .env
# The backend reads <project root>/.env regardless of the directory it is started from.
# Real environment variables override this file. Never commit the real .env.
# Every value below is a placeholder or the built-in default.

# ---- Environment ----
# development | test | production (production requires AI_PROVIDER=openai, a key and explicit CORS_ORIGINS)
APP_ENV=development

# ---- Database ----
# MongoDB connection string (local docker compose service shown; use the Atlas URI in deployment)
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name (must start with "resume_tailor_test" when APP_ENV=test)
MONGODB_DATABASE=resume_tailor_dev
# How long to wait for the database before reporting it unavailable, in milliseconds
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ---- Browser access ----
# Comma-separated exact frontend origins allowed by CORS; wildcards are rejected
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set to true only behind a trusted proxy (Render): client IP is taken from X-Forwarded-For
TRUST_PROXY_HEADERS=false
# Optional secret used to hash client IPs in rate-limit counters (derived from MONGODB_URI if empty)
IP_HASH_SALT=

# ---- AI provider ----
# openai (real, billable) | fake (deterministic demo/test mode; rejected in production)
AI_PROVIDER=openai
# OpenAI API key, used for both generation and embeddings; keep it server-side only
OPENAI_API_KEY=replace-with-your-openai-api-key
# Generation model: gpt-6-luna (default, lower cost) or gpt-5.6-terra
OPENAI_MODEL=gpt-6-luna
# Embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vector size; must match the embedding model (1536 for text-embedding-3-small)
OPENAI_EMBEDDING_DIMENSIONS=1536
# Reasoning effort sent to the generation model; leave empty to omit the parameter
OPENAI_REASONING_EFFORT=low
# Overall time limit for one provider call, retries included, in seconds
PROVIDER_TIMEOUT_SECONDS=120
# Maximum automatic retries of a failed provider call
PROVIDER_MAX_RETRIES=2
# Output token limits per operation (reasoning tokens count against them)
MAX_OUTPUT_TOKENS_EXTRACTION=32000
MAX_OUTPUT_TOKENS_JOB_ANALYSIS=8000
MAX_OUTPUT_TOKENS_GENERATION=16000
MAX_OUTPUT_TOKENS_REGENERATION=4000
MAX_OUTPUT_TOKENS_VERIFICATION=6000
# Optional LLM check of generated claims in addition to the deterministic validation
ENABLE_SEMANTIC_VERIFIER=false

# ---- Retrieval ----
# Retrieval backend; "python" (cosine ranking in the backend) is the only implemented value
RETRIEVAL_MODE=python
# Evidence candidates retrieved per job requirement
RETRIEVAL_PER_REQUIREMENT=4
# Maximum evidence records passed to generation
RETRIEVAL_MAX_CONTEXT=18
# Approximate token budget for the retrieved evidence
RETRIEVAL_TOKEN_BUDGET=6000

# ---- Sessions and input limits ----
# Hours until an anonymous session and all of its data expire
SESSION_TTL_HOURS=24
# Maximum total characters across all profile sources
MAX_PROFILE_CHARS=60000
# Maximum characters in a job description
MAX_JOB_CHARS=25000
# Maximum number of profile sources per ingest
MAX_SOURCES=5
# Maximum request body size in bytes
MAX_REQUEST_BYTES=400000
# Maximum evidence chunks per profile
MAX_EVIDENCE_CHUNKS=200
# Maximum requirements per job
MAX_REQUIREMENTS=25

# ---- Rate limits and quotas (persistent, stored in MongoDB) ----
# New sessions allowed per client IP per hour
SESSION_CREATE_LIMIT_PER_HOUR=20
# Attempts allowed per session for each operation
QUOTA_INGEST=8
QUOTA_CONFIRM=15
QUOTA_JOB_ANALYSIS=15
QUOTA_GENERATION=12
QUOTA_REGENERATION=40
QUOTA_VALIDATION=40
# AI provider calls allowed per UTC day across all sessions
GLOBAL_DAILY_AI_CALL_LIMIT=600
